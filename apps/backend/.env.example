# Required: LLM provider key for Mastra agents
OPENAI_API_KEY=sk-...

# Required: GitHub personal access token (repo + PR write scope)
GITHUB_TOKEN=ghp_...

# Optional: Secret for validating GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Optional: Port for the HTTP server (default: 3000)
PORT=3000

# Optional: Allowed CORS origin (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
